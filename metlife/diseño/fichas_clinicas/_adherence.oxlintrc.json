{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blocks/**",
              "components/primitives/**",
              "ui_kits/ficha-producto/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IvyPresto Text|IvyPresto Headline|IvyPresto Display|Inter))/i]",
        "message": "Font not provided by the design system. Available: IvyPresto Text, IvyPresto Headline, IvyPresto Display, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|set|variant|size|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<BrandIcon> doesn't accept that prop. Declared props: name, set, variant, size, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandIcon'] > JSXAttribute[name.name='set'] > Literal[value!=/^(?:category|product)$/]",
        "message": "<BrandIcon> set must be one of 'category' | 'product'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandIcon'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<BrandIcon> variant must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|columns|style|key|ref|className|style|children)$/]",
        "message": "<BulletGrid> doesn't accept that prop. Declared props: items, columns, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|width|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FichaFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:partnerLogo|partnerName|allianceLine|link|logo|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<FichaFooter> doesn't accept that prop. Declared props: partnerLogo, partnerName, allianceLine, link, logo, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FichaHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|badge|photo|photoPosition|photoZoom|logo|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<FichaHeader> doesn't accept that prop. Declared props: title, badge, photo, photoPosition, photoZoom, logo, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FichaPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<FichaPage> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GeneralConditions'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|style|key|ref|className|style|children)$/]",
        "message": "<GeneralConditions> doesn't accept that prop. Declared props: title, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntroParagraph'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<IntroParagraph> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyDataCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<KeyDataCard> doesn't accept that prop. Declared props: icon, value, label, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyDataCard'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:ShieldProtection|FinancialStrength|Stethoscope|Heart|Family|HelpingTheElderly)$/]",
        "message": "<KeyDataCard> icon must be one of 'ShieldProtection' | 'FinancialStrength' | 'Stethoscope' | 'Heart' | 'Family' | 'HelpingTheElderly'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyDataGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<KeyDataGrid> doesn't accept that prop. Declared props: items, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegalNotes'] > JSXAttribute > JSXIdentifier[name!=/^(?:notes|missing|style|key|ref|className|style|children)$/]",
        "message": "<LegalNotes> doesn't accept that prop. Declared props: notes, missing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
